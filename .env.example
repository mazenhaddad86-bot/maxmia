# =====================================================================
# VIDEO AUTOMATION PIPELINE — alle API-Keys an einer Stelle
# Kopiere diese Datei zu .env und trage deine echten Keys ein.
# .env wird NIEMALS committed (siehe .gitignore).
# =====================================================================

# --- HIGGSFIELD (Bilder + Video) ---
# Account: https://higgsfield.ai → Settings → API Keys
HIGGSFIELD_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxx
HIGGSFIELD_API_BASE=https://api.higgsfield.ai

# --- SUNO (Audio) — über Drittanbieter, da keine offizielle API ---
# Empfohlen: https://sunoapi.org  oder  https://apipass.io
# Trage einen davon ein und setze SUNO_PROVIDER entsprechend
SUNO_PROVIDER=sunoapi_org
SUNO_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
SUNO_API_BASE=https://api.sunoapi.org

# --- OPENAI (optional — für Topic-/Script-Generierung) ---
# Wenn leer: nutzt fixe Topics aus config/themes.yaml im Round-Robin
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- YOUTUBE Data API v3 ---
# 1. Console: https://console.cloud.google.com → neues Projekt
# 2. APIs aktivieren: "YouTube Data API v3"
# 3. OAuth-Client (Desktop) erstellen → client_secrets.json runterladen
# 4. Lege client_secrets.json in scripts/ ab
# 5. Einmalig: python scripts/setup_youtube_oauth.py  → erzeugt token.json
YOUTUBE_ENABLED=true
YOUTUBE_TOKEN_FILE=scripts/youtube_token.json
YOUTUBE_CLIENT_SECRETS=scripts/client_secrets.json
YOUTUBE_PRIVACY=public          # public | unlisted | private
YOUTUBE_CATEGORY_ID=22           # 22=People&Blogs, 24=Entertainment, 28=Sci&Tech
YOUTUBE_MADE_FOR_KIDS=false

# --- TIKTOK Content Posting API ---
# https://developers.tiktok.com → App erstellen → "Content Posting API" beantragen
# Hinweis: Vor App-Audit sind Posts nur PRIVAT sichtbar
TIKTOK_ENABLED=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE   # PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | SELF_ONLY

# --- META (Instagram + Facebook) ---
# https://developers.facebook.com → App → "Instagram Graph API" + "Pages API"
# Insta-Account muss ein BUSINESS-Account sein, der mit einer FB-Page verbunden ist.
INSTAGRAM_ENABLED=false
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

FACEBOOK_ENABLED=false
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# --- ABLAGE / TIMING ---
OUTPUT_DIR=output
KEEP_RAW_ASSETS=true              # Bilder/Audio nach Compose behalten?
VIDEO_DURATION_SEC=10             # Higgsfield: 5 oder 10
VIDEO_RATIO=9:16                  # 9:16 für Shorts/Reels/TikTok
VIDEO_RESOLUTION=1080p
